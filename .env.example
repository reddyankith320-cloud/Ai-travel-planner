# ===========================================================================
# TripWise — backend environment
#
# Copy to `.env` (which .gitignore already excludes) and fill in only what you
# need. TripWise runs with NONE of these set: it starts in demo mode, every
# figure comes from its own deterministic cost model, and every figure is
# labelled as an estimate. Nothing is ever presented as a live quote.
#
# Each key below is explained — including what it costs and what breaks
# without it — in docs/API_KEYS.md.
#
# NEVER put any of these in the frontend. Values in frontend/.env are compiled
# into the browser bundle and are public. Private keys live here only.
# ===========================================================================

# --- Core ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
# Comma-separated browser origins allowed to call this API. Never use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---------------------------------------------------------------
# Defaults to a local SQLite file, so no database server is needed to start.
# For production use PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://tripwise:CHANGE_ME@localhost:5432/tripwise
DATABASE_URL=sqlite+pysqlite:///./tripwise.db

# Optional shared cache. Without it an in-process cache is used, which is
# fine for a single worker. With several workers, Redis stops each one
# separately hammering the same provider quota.
# REDIS_URL=redis://localhost:6379/0

# ===========================================================================
# AI itinerary generation (optional)
#
# Without a key TripWise still produces full day-by-day itineraries using its
# deterministic planner, which geo-clusters stops and respects opening hours.
# An LLM improves the sequencing and the writing; it never sets a price.
# ===========================================================================
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI is supported as an alternative. OPENAI_MODEL has no default on
# purpose: OpenAI model IDs change often enough that a hardcoded one would
# silently break. List current IDs with:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
# OPENAI_API_KEY=
# OPENAI_MODEL=

# auto (prefers Anthropic) | anthropic | openai | none
LLM_PROVIDER=auto

# ===========================================================================
# Maps, geocoding, routing and places (all optional)
#
# Providers are tried in priority order and fall back to the next on failure.
# ===========================================================================

# --- Google Maps Platform --------------------------------------------------
# Requires a billing account. The old $200/month universal credit is GONE —
# billing is now per-SKU with its own free allowance per API. Create TWO keys:
#  * a SERVER key, IP-restricted, for Geocoding / Routes / Places
#  * a BROWSER key, HTTP-referrer-restricted, if you use Google map tiles
# GOOGLE_MAPS_SERVER_KEY=
# GOOGLE_MAPS_BROWSER_KEY=

# --- Geoapify (good free tier, one key covers several services) ------------
# GEOAPIFY_API_KEY=

# --- LocationIQ (free tier allows commercial use WITH attribution) ---------
# LOCATIONIQ_API_KEY=

# --- OpenRouteService (routing only) ---------------------------------------
# OPENROUTESERVICE_API_KEY=

# --- Foursquare Places -----------------------------------------------------
# FOURSQUARE_API_KEY=

# --- Keyless OpenStreetMap services ----------------------------------------
# Free and need no key, but they are FAIR-USE community services with no SLA.
# TripWise rate-limits and caches them. For production traffic, self-host or
# use a paid provider above, and set these to false.
ENABLE_NOMINATIM=true
ENABLE_OSRM=true
ENABLE_OVERPASS=true
ENABLE_OPEN_METEO=true
# Nominatim's usage policy requires a contact address in the User-Agent.
# OSM_CONTACT_EMAIL=you@example.com

# Destination photographs from Wikipedia/Wikimedia. No key needed, freely
# licensed, attribution is rendered in the UI. Without this the UI draws
# generated cover art rather than showing a photo of somewhere else.
ENABLE_WIKIMEDIA_IMAGES=true

# ===========================================================================
# Flights and hotels (optional)
#
# IMPORTANT: there is NO legitimate public API for Indian Railways fares or
# for intercity bus fares. TripWise therefore always ESTIMATES those and links
# to the official booking channel (IRCTC, state RTCs). It never fabricates
# live availability, seat counts or ticket prices.
#
# Amadeus Self-Service is implemented but UNVERIFIED: third-party sources
# report the Self-Service portal was decommissioned in July 2026, which we
# could not confirm with Amadeus directly. Check your account status before
# enabling it. See docs/PROVIDERS.md.
# ===========================================================================
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test
# none | amadeus
FLIGHT_PROVIDER=none
HOTEL_PROVIDER=none

# ===========================================================================
# Network behaviour and limits
# ===========================================================================
HTTP_TIMEOUT_SECONDS=8.0
HTTP_MAX_RETRIES=2
HTTP_BACKOFF_BASE_SECONDS=0.4
# Cache TTL in seconds (6h). Check each provider's terms before raising it —
# some licences limit how long responses may be stored.
CACHE_TTL_SECONDS=21600
CACHE_MAX_ENTRIES=5000

# Per-IP rate limit. This protects your provider quotas as much as the server.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ===========================================================================
# Cost model
# ===========================================================================
# Emergency buffer added on top of the taxed subtotal (0.08 = 8%).
CONTINGENCY_RATE=0.08
# How far over budget a "stretch" option may be before it is dropped entirely.
STRETCH_BUDGET_TOLERANCE=0.15
DEFAULT_CURRENCY=INR
