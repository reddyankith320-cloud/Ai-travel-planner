# ===========================================================================
# TripWise — backend environment
#
#   cp .env.example backend/.env
#
# Then paste your keys after the "=" signs below. Nothing else to do.
#
# TripWise runs with EVERY slot below left blank. It starts in demo mode,
# every figure comes from its own cost model, and every figure is labelled as
# an estimate. Fill slots in as you get keys — one at a time is fine, and a
# half-filled file is a perfectly valid state.
#
# A blank slot, a slot holding a placeholder, and a deleted line all behave
# identically: that provider is simply not used. Quotes and stray spaces
# around a pasted key are stripped automatically.
#
# After editing, check what registered:    ./scripts/check-keys.sh
#
# Where to get each key, what it costs, and what it unlocks:  docs/API_KEYS.md
#
# NEVER put any of these in frontend/.env — values there are compiled into the
# browser bundle and are public. Private keys live in this file only.
# ===========================================================================


# ---------------------------------------------------------------------------
# PASTE YOUR KEYS HERE
#
# Each line is a ready slot. Leave blank what you do not have yet.
# ---------------------------------------------------------------------------

# Lets users type a city name instead of granting location access.
# One key covers geocoding + routing + places.  https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# AI-written itineraries. Without it, a deterministic planner does the job.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Alternative to Anthropic. BOTH lines are required for OpenAI to be used —
# there is no default model, because OpenAI model IDs change often. List them:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
OPENAI_API_KEY=
OPENAI_MODEL=

# Real road distances instead of terrain-adjusted estimates.
# https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=

# Another geocoder. Free tier allows commercial use ONLY if you display a
# "Search by LocationIQ.com" link in your UI.  https://locationiq.com/register
LOCATIONIQ_API_KEY=

# More points of interest.  https://foursquare.com/developers/
FOURSQUARE_API_KEY=

# Google Maps Platform. Requires a billing account — the old $200/month
# universal credit no longer exists. Create TWO separate keys:
#   SERVER key  -> restrict by IP address, never leaves this file
#   BROWSER key -> restrict by HTTP referrer, only needed for Google map tiles
# Set a quota cap and a budget alert before you ship. https://console.cloud.google.com/
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Live flight and hotel prices.
# NOTE: third-party sources report the Amadeus Self-Service portal was
# decommissioned in July 2026; we could not confirm this with Amadeus. Check
# your account works before relying on it. Both lines AND the two provider
# switches further down are needed to turn it on.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Required by Nominatim's usage policy if you use the keyless geocoder below.
# Not a secret — just an address they can reach you at.
OSM_CONTACT_EMAIL=


# ===========================================================================
# There is NO key for Indian trains or buses
#
# No legitimate public API exists for Indian Railways or intercity bus fares.
# IRCTC runs no public developer programme, eRail's API is suspended, and the
# npm packages claiming to offer access are unofficial scrapers.
#
# TripWise therefore always ESTIMATES those fares, labels them as estimates,
# and links to IRCTC, NTES and the state road transport corporations for the
# real thing. There is nothing to configure here, and nothing is scraped.
# ===========================================================================


# ---------------------------------------------------------------------------
# Everything below has working defaults. Leave it alone unless you need to.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
# Browser origins allowed to call this API. Never use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---------------------------------------------------------------
# Defaults to a local SQLite file, so no database server is needed.
# For production:
#   DATABASE_URL=postgresql+psycopg://tripwise:CHANGE_ME@localhost:5432/tripwise
DATABASE_URL=sqlite+pysqlite:///./tripwise.db

# Optional shared cache. Without it an in-process cache is used, which is fine
# for a single worker. With several, Redis stops each one separately burning
# the same provider quota.
REDIS_URL=

# --- LLM routing -----------------------------------------------------------
# auto (prefers Anthropic) | anthropic | openai | none
LLM_PROVIDER=auto
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Keyless OpenStreetMap services ----------------------------------------
# Free, no signup, but FAIR-USE community services with no SLA. TripWise rate-
# limits and caches them. For production traffic, self-host or use a
# credentialed provider above and set these to false.
ENABLE_NOMINATIM=true
ENABLE_OSRM=true
ENABLE_OVERPASS=true

# Seasonal weather. Free tier is NON-COMMERCIAL under ~10k calls/day.
# Subscribe to Open-Meteo or set this to false for commercial use.
ENABLE_OPEN_METEO=true

# Destination photographs from Wikipedia/Wikimedia. No key, freely licensed,
# attribution rendered in the UI. Off = generated cover art instead.
ENABLE_WIKIMEDIA_IMAGES=true

# --- Flight / hotel providers ----------------------------------------------
# none | amadeus   (also needs the AMADEUS_* credentials above)
FLIGHT_PROVIDER=none
HOTEL_PROVIDER=none
# 'test' serves cached, non-market data. Development only.
AMADEUS_ENVIRONMENT=test

# --- Network behaviour -----------------------------------------------------
HTTP_TIMEOUT_SECONDS=8.0
HTTP_MAX_RETRIES=2
HTTP_BACKOFF_BASE_SECONDS=0.4
# 6 hours. Check your providers' terms before raising this — some licences
# limit how long their responses may be stored.
CACHE_TTL_SECONDS=21600
CACHE_MAX_ENTRIES=5000

# Per-IP rate limit. Protects your provider quotas as much as the server.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Cost model ------------------------------------------------------------
# Emergency buffer on top of the taxed subtotal (0.08 = 8%).
CONTINGENCY_RATE=0.08
# How far over budget a "stretch" option may be before it is dropped.
STRETCH_BUDGET_TOLERANCE=0.15
DEFAULT_CURRENCY=INR
