# ===========================================================================
# TripWise — backend environment
#
#   cp .env.example backend/.env
#
# TripWise is FREE TO RUN with every slot below left blank. It uses
# OpenStreetMap for maps, geocoding, routing and places, Open-Meteo for
# seasonal weather, and its own deterministic planner for itineraries. None of
# those need a key, a card, or a signup.
#
# There are exactly TWO optional keys, and both cost money:
#
#   GOOGLE MAPS  - better geocoding, real road distances, richer place data.
#                  Requires a billing account with a card. The old $200/month
#                  credit no longer exists; each API now has its own monthly
#                  free allowance and they do not pool. Low traffic can stay
#                  inside the free allowance, but a runaway loop will bill you.
#                  SET A QUOTA CAP AND A BUDGET ALERT.
#
#   OPENAI       - itineraries written by a model instead of by the built-in
#                  planner. There is NO free tier; every call costs money.
#
# Add them only if you want what they buy. Nothing breaks without them.
#
# After editing:  ./scripts/check-keys.sh
# Where to get them, step by step:  docs/API_KEYS.md
#
# NEVER put a private key in frontend/.env — values there are compiled into the
# browser bundle and are public.
# ===========================================================================


# ---------------------------------------------------------------------------
# PASTE YOUR KEYS HERE  (both optional — blank means "use the free path")
# ---------------------------------------------------------------------------

# Google Maps, SERVER key. Geocoding + Routes + Places.
# Restrict by IP address in the Google console. Never leaves this file.
GOOGLE_MAPS_SERVER_KEY=

# Google Maps, BROWSER key. Map tiles only, and ONLY if you want Google tiles
# instead of the free OpenStreetMap ones.
# This key ships in the browser bundle and is readable by anyone, so it MUST be
# restricted by HTTP referrer in the Google console. Create it as a SEPARATE
# key from the server one above.
# NOTE: this one also has to be set in frontend/.env as
# VITE_GOOGLE_MAPS_BROWSER_KEY, because it is used at build time.
GOOGLE_MAPS_BROWSER_KEY=

# OpenAI. Itineraries written by a model.
# Leave OPENAI_MODEL blank and TripWise asks the API which models your key can
# use and picks a current one. Set it only to pin a specific model.
OPENAI_API_KEY=
OPENAI_MODEL=

# Not a secret, and not a key. Nominatim's usage policy asks for an address
# they can reach you at if you rely on the free geocoder.
OSM_CONTACT_EMAIL=


# ===========================================================================
# There is NO key for Indian trains or buses
#
# No legitimate public API exists for Indian Railways or intercity bus fares.
# IRCTC runs no public developer programme, eRail's API is suspended, and the
# packages claiming to offer access are unofficial scrapers.
#
# TripWise always ESTIMATES those fares, labels them as estimates, and links to
# IRCTC, NTES and the state road transport corporations for the real thing.
# Flight and hotel prices are modelled for the same reason. Nothing is scraped.
# ===========================================================================


# ---------------------------------------------------------------------------
# Everything below has working defaults. Leave it alone unless you need to.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
# Browser origins allowed to call this API. Never use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---------------------------------------------------------------
# A local SQLite file, so no database server is needed. For production:
#   DATABASE_URL=postgresql+psycopg://tripwise:CHANGE_ME@localhost:5432/tripwise
DATABASE_URL=sqlite+pysqlite:///./tripwise.db

# Optional shared cache. Without it an in-process cache is used, which is fine
# for a single worker.
REDIS_URL=

# --- The free stack (no keys, no signup) -----------------------------------
# OpenStreetMap services. Free, but FAIR-USE with no SLA, so TripWise rate-
# limits and caches them. For heavy production traffic, self-host or add the
# Google key above.
ENABLE_NOMINATIM=true
ENABLE_OSRM=true
ENABLE_OVERPASS=true

# Seasonal weather. Free tier is NON-COMMERCIAL under ~10k calls/day.
ENABLE_OPEN_METEO=true

# Destination photographs from Wikipedia/Wikimedia. Free, attribution shown.
ENABLE_WIKIMEDIA_IMAGES=true

# Set false to keep the key in place but stop calling the model.
ENABLE_LLM=true

# --- Network behaviour -----------------------------------------------------
HTTP_TIMEOUT_SECONDS=8.0
HTTP_MAX_RETRIES=2
HTTP_BACKOFF_BASE_SECONDS=0.4
# 6 hours. Caching is also what keeps you inside a free allowance.
CACHE_TTL_SECONDS=21600
CACHE_MAX_ENTRIES=5000

# Per-IP rate limit. Protects your Google quota as much as the server.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Cost model ------------------------------------------------------------
CONTINGENCY_RATE=0.08
STRETCH_BUDGET_TOLERANCE=0.15
DEFAULT_CURRENCY=INR
