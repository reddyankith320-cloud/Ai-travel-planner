# ===========================================================================
# TripWise — frontend environment
#
# EVERYTHING HERE IS PUBLIC. Values in VITE_* variables are compiled into the
# JavaScript bundle and are readable by anyone who loads the page.
# Never put a server key, a secret, or a database URL in this file.
# ===========================================================================

# Where the API lives. Leave blank in development to use the Vite proxy.
VITE_API_BASE_URL=

# Dev-only: where the Vite proxy forwards /api.
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional. Google Maps BROWSER key, for Google map tiles instead of the free
# OpenStreetMap ones. Leave blank and OpenStreetMap is used, which needs no key
# and costs nothing.
#
# This key is public by design. The only thing protecting it is an HTTP
# referrer restriction set in the Google Cloud console — do that before you
# deploy, and restrict it to the Maps APIs alone. It must be a DIFFERENT key
# from GOOGLE_MAPS_SERVER_KEY, which stays on the backend.
VITE_GOOGLE_MAPS_BROWSER_KEY=
