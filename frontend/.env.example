# ---------------------------------------------------------------------------
# Frontend environment. ONLY put values here that are safe in a browser.
#
# Anything in a VITE_* variable is compiled into the JavaScript bundle and is
# readable by anyone who loads the page. Never put a server API key here.
# All private keys belong in the backend's own .env file.
# ---------------------------------------------------------------------------

# Where the TripWise API lives. Leave blank in development to use the Vite
# proxy (which forwards /api to the backend).
VITE_API_BASE_URL=

# Dev-only: where the Vite proxy should forward /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional. A *browser-restricted* Google Maps key, if you choose Google tiles
# instead of the default OpenStreetMap ones. This key is public by design and
# MUST be locked down by HTTP referrer in the Google Cloud console, and
# restricted to the Maps JavaScript API only. If you are unsure, leave it
# blank: TripWise uses OpenStreetMap tiles, which need no key.
VITE_GOOGLE_MAPS_BROWSER_KEY=
